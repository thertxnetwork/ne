# Telegram API Credentials (Required)
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Phone Number (Optional - only needed for creating new sessions)
# Include country code, e.g., +1234567890
PHONE=+1234567890

# Bot Username (Optional - if not provided, will prompt)
BOT_USERNAME=mybot

# Authorization URL (Optional - defaults to https://numbernewone.com/auth/telegram/authorize)
AUTH_URL=https://numbernewone.com/auth/telegram/authorize
